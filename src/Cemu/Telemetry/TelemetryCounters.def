// Counter declarations for the telemetry harness. Single source of truth: this file
// generates the CounterId enum, the metadata table written into every run header, and
// nothing else. Adding a counter is one line here plus one TLM_INC at the site.
//
//   TLM_COUNTER(id, "dotted.name", "unit", Area)
//
// Names are dotted and stable -- the run header carries the id->name table, and the
// differ aligns two runs by name, so a counter may be added or removed between builds
// without silently misaligning older files. Do not renumber; do not reuse a name for a
// different meaning.
//
// All counters are uint64 and monotonic within a run. Per-frame values are deltas
// computed at the frame boundary, so a counter must only ever be incremented.

// ---------------------------------------------------------------- GPU / Latte / Metal
TLM_COUNTER(GpuFrames,              "gpu.frames",                "count", Gpu)
TLM_COUNTER(GpuDrawCalls,           "gpu.draw_calls",            "count", Gpu)
TLM_COUNTER(GpuDrawCallsFast,       "gpu.draw_calls_fast",       "count", Gpu)
TLM_COUNTER(GpuRenderPasses,        "gpu.render_passes",         "count", Gpu)
TLM_COUNTER(GpuRenderPassesTemp,    "gpu.render_passes_temp",    "count", Gpu)
TLM_COUNTER(GpuCommandBuffers,      "gpu.command_buffers",       "count", Gpu)
TLM_COUNTER(GpuCommandBuffersDone,  "gpu.command_buffers_done",  "count", Gpu)
TLM_COUNTER(GpuBusyNs,              "gpu.busy_ns",               "ns",    Gpu)
TLM_COUNTER(GpuClears,              "gpu.clears",                "count", Gpu)
TLM_COUNTER(GpuDrawsManualFetch,    "gpu.draws_manual_fetch",    "count", Gpu)
TLM_COUNTER(GpuDrawsMesh,           "gpu.draws_mesh",            "count", Gpu)
TLM_COUNTER(GpuDrawsTriangleFan,    "gpu.draws_triangle_fan",    "count", Gpu)
TLM_COUNTER(GpuShadersCompiledVS,   "gpu.shaders_compiled_vs",   "count", Gpu)
TLM_COUNTER(GpuShadersCompiledGS,   "gpu.shaders_compiled_gs",   "count", Gpu)
TLM_COUNTER(GpuShadersCompiledPS,   "gpu.shaders_compiled_ps",   "count", Gpu)
TLM_COUNTER(GpuPipelinesCompiled,   "gpu.pipelines_compiled",    "count", Gpu)
TLM_COUNTER(GpuCpIdleNs,            "gpu.cp_idle_ns",            "ns",    Gpu)
// Anatomy of the ring-starvation loop. cp_idle_notify counts every pass; rb_wait_parked
// counts the ones that actually reached the wfe (~1250 ns each, verified by probe);
// cp_idle_full_pass counts the ones that fell through to the periodic work and sched_yield.
// The ratios say whether this loop is a cheap near-miss or a syscall storm.
TLM_COUNTER(GpuRbWaitEarlyOut,      "gpu.rb_wait_early_out",     "count", Gpu)
TLM_COUNTER(GpuRbWaitParked,        "gpu.rb_wait_parked",        "count", Gpu)
TLM_COUNTER(GpuRbWaitParkedNs,      "gpu.rb_wait_parked_ns",     "ns",    Gpu)
TLM_COUNTER(GpuCpIdleFullPass,      "gpu.cp_idle_full_pass",     "count", Gpu)
TLM_COUNTER(GpuCpIdlePeriodicNs,    "gpu.cp_idle_periodic_ns",   "ns",    Gpu)
TLM_COUNTER(GpuCpIdleYieldNs,       "gpu.cp_idle_yield_ns",      "ns",    Gpu)
TLM_COUNTER(GpuCpFenceNs,           "gpu.cp_fence_ns",           "ns",    Gpu)
// Where a frame's wall-clock goes when the GPU is not busy. The reporter subtracts these
// from the frame interval to get the underlying *work* time, which is what says how far
// a scene is from the vsync quantisation cliff.
TLM_COUNTER(GpuWaitFlipNs,          "gpu.wait_flip_ns",          "ns",    Gpu)
TLM_COUNTER(GpuDrawableWaitNs,      "gpu.drawable_wait_ns",      "ns",    Gpu)
// IT_WAIT_REG_MEM: the GPU command processor waiting until the guest CPU writes a value.
// SOLVED, and it is not a defect: cp_fence_ns is "time until the next emulated vsync".
// The fence is released 10us after a vsync signal (fence_release_lag_ns below), exactly one
// vsync and one flip fire per stall, and the duration is identical in a 113-draw menu and
// 3,516-draw gameplay. The guest thread owning the fence is parked in GX2WaitForFlip; the
// flip comes from LatteTiming's polled software timer, which this same wait loop drives.
// Do not treat this as time to be recovered.
TLM_COUNTER(GpuFenceTotal,          "gpu.fence_total",           "count", Gpu)
TLM_COUNTER(GpuFenceStalls,         "gpu.fence_stalls",          "count", Gpu)
TLM_COUNTER(GpuFenceSpins,          "gpu.fence_spins",           "count", Gpu)
// IT_MEM_SEMAPHORE was the one command-processor wait with no instrumentation at all, so
// any time it took was invisible and landed on whatever enclosed it.
TLM_COUNTER(GpuCpSemaphoreNs,       "gpu.cp_semaphore_ns",       "ns",    Gpu)
TLM_COUNTER(GpuCpSemaphoreWaits,    "gpu.cp_semaphore_waits",    "count", Gpu)
TLM_COUNTER(GpuCpSemaphoreSpins,    "gpu.cp_semaphore_spins",    "count", Gpu)
// wait_flip was timed but never counted, so a long wait and a hot spin looked identical.
TLM_COUNTER(GpuWaitFlipSpins,       "gpu.wait_flip_spins",       "count", Gpu)
// Does the renderer have work in hand while the command processor is blocked? The idle
// notification exists and its body is commented out, so if these fire the recorded draws
// sit unsubmitted for the whole stall and the GPU starves itself waiting for the guest.
TLM_COUNTER(GpuCpIdleNotify,        "gpu.cp_idle_notify",        "count", Gpu)
TLM_COUNTER(GpuCpIdleWithPendingWork,"gpu.cp_idle_pending",      "count", Gpu)
TLM_COUNTER(GpuCpIdlePendingDrawcalls,"gpu.cp_idle_pending_draws","count",Gpu)
// Commits forced by --commit-on-fence-stall. Zero unless the flag is passed.
TLM_COUNTER(GpuCpIdleCommits,       "gpu.cp_idle_commits",       "count", Gpu)
// Staging ring buffers ever allocated. Should be 1. Climbing means command-buffer
// retirement has stopped reclaiming and each 32 MB ring is being abandoned in turn.
TLM_COUNTER(GpuStagingRingsCreated, "gpu.staging_rings_created", "count", Gpu)
// Is the fence wait a timer? It lasts ~15.3 ms whether the title draws 113 objects or
// 3,516, which no work dependency explains. Emulated vsync IS a timer that the Latte
// thread polls from inside the wait loop, and GX2WaitForFlip parks guest threads on it --
// so if the fence is released by a thread waiting for a flip, release_lag_ns (time from
// the last vsync signal to the fence coming free) collapses to microseconds.
TLM_COUNTER(GpuFenceVsyncDuring,    "gpu.fence_vsync_during",    "count", Gpu)
TLM_COUNTER(GpuFenceFlipDuring,     "gpu.fence_flip_during",     "count", Gpu)
TLM_COUNTER(GpuFenceReleaseLagNs,   "gpu.fence_release_lag_ns",  "ns",    Gpu)
// GPU pipeline bubbles: summed gaps between one command buffer ending and the next
// starting. Command buffers are serialised on an MTLEvent, so a gap is time the GPU had
// nothing to run. gpu.busy_ns alone cannot tell "busy 19 ms" from "busy 19 ms spread over
// 35 ms of wall clock", and those need opposite fixes.
TLM_COUNTER(GpuGapNs,               "gpu.gap_ns",                "ns",    Gpu)
TLM_COUNTER(GpuGapCount,            "gpu.gap_count",             "count", Gpu)
TLM_COUNTER(GpuGapLarge,            "gpu.gap_large",             "count", Gpu)  // > 4 ms
// Split the gap by whether the buffer before it carried the frame's present. One big
// inter-frame gap is the GPU finishing early and waiting for vsync, which is fine; a big
// intra-frame gap is the CPU failing to keep it fed, which is not. Size alone cannot tell
// them apart.
TLM_COUNTER(GpuGapInterframeNs,     "gpu.gap_interframe_ns",     "ns",    Gpu)
TLM_COUNTER(GpuGapIntraframeNs,     "gpu.gap_intraframe_ns",     "ns",    Gpu)
// Time from commit() to the GPU actually starting a buffer. THE hard upper bound on what any
// change to command-buffer ordering could win back -- worth knowing before paying for one.
TLM_COUNTER(GpuQueueLatencyNs,      "gpu.queue_latency_ns",      "ns",    Gpu)
// Samples where GPUStartTime came out at or before the host commit stamp -- i.e. the two
// clocks do not share a timebase after all. Should be 0; if it is not, queue_latency_ns is
// meaningless rather than small.
TLM_COUNTER(GpuQueueLatencyRejected,"gpu.queue_latency_rejected","count", Gpu)
// First GetCommandBuffer() of a frame -> that frame's presenting buffer leaving the GPU.
// Tests the "CPU work + GPU work overruns the two-vsync-slot deadline" model directly
// instead of inferring it from two numbers that are measured separately.
TLM_COUNTER(GpuFrameCriticalPathNs, "gpu.frame_critical_path_ns","ns",    Gpu)
// GX2DrawDone's IT_HLE_SYNC_ASYNC_OPERATIONS: a full pipeline drain that blocks BOTH the
// guest (GX2WaitTimeStamp -> OSWaitEvent) and the Latte thread (two waitUntilCompleted
// paths). If a title emits this per frame it explains a stalled pipeline all by itself, with
// no help from the renderer.
TLM_COUNTER(GpuSyncAsyncPackets,    "gpu.sync_async_packets",    "count", Gpu)
TLM_COUNTER(GpuSyncAsyncNs,         "gpu.sync_async_ns",         "ns",    Gpu)
TLM_COUNTER(GpuOcclusionQueries,    "gpu.occlusion_queries",     "count", Gpu)
TLM_COUNTER(GpuOcclusionFlushes,    "gpu.occlusion_flushes",     "count", Gpu)
TLM_COUNTER(GpuOcclusionFlushNs,    "gpu.occlusion_flush_ns",    "ns",    Gpu)
TLM_COUNTER(GpuReadbackForceFinishes,"gpu.readback_forcefinish",  "count", Gpu)
TLM_COUNTER(GpuReadbackForceFinishNs,"gpu.readback_forcefinish_ns","ns",   Gpu)
// Was the readback we block on at GX2DrawDone one that the forced update had just started
// (so it got no GPU time at all), or one already in flight? Different fixes.
TLM_COUNTER(GpuReadbackForceStart,  "gpu.readback_forcestart",   "count", Gpu)
TLM_COUNTER(GpuReadbackAgeAtWaitNs, "gpu.readback_age_at_wait_ns","ns",   Gpu)

// ------------------------------------------------------------------------- CPU / JIT
TLM_COUNTER(CpuGuestCyclesRetired,  "cpu.guest_cycles_retired",  "count", Cpu)
TLM_COUNTER(CpuThreadSwitches,      "cpu.thread_switches",       "count", Cpu)
TLM_COUNTER(CpuRecompilerEnter,     "cpu.recompiler_enter",      "count", Cpu)
TLM_COUNTER(CpuRecompilerLeaveEarly,"cpu.recompiler_leave_early","count", Cpu)
TLM_COUNTER(CpuHleCalls,            "cpu.hle_calls",             "count", Cpu)
// Counterfactual, NOT applied: what a flat 500-cycle-per-HLE-call charge would come to.
// Resolved HLE calls currently advance guest time by one cycle (the trampoline is a single
// PPC instruction inside a block charged by PPCREC_IML_MACRO_COUNT_CYCLES), so a guest
// thread doing nothing but library calls never exhausts its 45,000-cycle quantum. Compare
// this against cpu.guest_cycles_retired to see whether modelling that cost could matter.
TLM_COUNTER(CpuHleWouldChargeCycles,"cpu.hle_would_charge_cycles","count", Cpu)
// Per-guest-core busy and idle. Keyed by spr.UPIR (the guest-visible core index), NOT by
// t_assignedCoreIndex -- the two disagree in singlecore mode, where one host thread
// rotates all three logical cores. These three must stay CONSECUTIVE and in this order:
// the runtime-indexed timer adds the core number to the first id (static_assert in
// Telemetry.h enforces it).
TLM_COUNTER(CpuCoreBusyNs0,         "cpu.core0_busy_ns",         "ns",    Cpu)
TLM_COUNTER(CpuCoreBusyNs1,         "cpu.core1_busy_ns",         "ns",    Cpu)
TLM_COUNTER(CpuCoreBusyNs2,         "cpu.core2_busy_ns",         "ns",    Cpu)
TLM_COUNTER(CpuCoreIdleNs0,         "cpu.core0_idle_ns",         "ns",    Cpu)
TLM_COUNTER(CpuCoreIdleNs1,         "cpu.core1_idle_ns",         "ns",    Cpu)
TLM_COUNTER(CpuCoreIdleNs2,         "cpu.core2_idle_ns",         "ns",    Cpu)
// Why a guest thread stopped running. The cores sit ~80% idle in the open world, which
// means threads are blocked rather than out of quantum -- these say on what. Counted at
// OSThreadQueueInternal::queueAndWait call sites, the single choke point for blocking.
TLM_COUNTER(CpuBlockEvent,          "cpu.block.event",           "count", Cpu)
TLM_COUNTER(CpuBlockMutex,          "cpu.block.mutex",           "count", Cpu)
TLM_COUNTER(CpuBlockCond,           "cpu.block.cond",            "count", Cpu)
TLM_COUNTER(CpuBlockSemaphore,      "cpu.block.semaphore",       "count", Cpu)
TLM_COUNTER(CpuBlockMsgQueue,       "cpu.block.msgqueue",        "count", Cpu)
TLM_COUNTER(CpuBlockSleep,          "cpu.block.sleep",           "count", Cpu)
TLM_COUNTER(CpuBlockJoin,           "cpu.block.join",            "count", Cpu)
TLM_COUNTER(CpuBlockGx2Vsync,       "cpu.block.gx2_vsync",       "count", Cpu)
TLM_COUNTER(CpuBlockGx2Flip,        "cpu.block.gx2_flip",        "count", Cpu)
// Not a block: the guest voluntarily giving up the rest of its timeslice. Separated
// because a yield-heavy workload and a block-heavy one need different fixes.
TLM_COUNTER(CpuYield,               "cpu.yield",                 "count", Cpu)
TLM_COUNTER(CpuQuantumEnd,          "cpu.quantum_end",           "count", Cpu)

// -------------------------------------------------------------------- Memory / caches
TLM_COUNTER(MemBufCacheScans,       "mem.bufcache.scans",        "count", Mem)
TLM_COUNTER(MemBufCachePagesScanned,"mem.bufcache.pages_scanned","count", Mem)
TLM_COUNTER(MemBufCachePageMiss,    "mem.bufcache.page_miss",    "count", Mem)
TLM_COUNTER(MemBufCacheUploads,     "mem.bufcache.uploads",      "count", Mem)
TLM_COUNTER(MemBufCacheUploadBytes, "mem.bufcache.upload_bytes", "bytes", Mem)
TLM_COUNTER(MemShaderCacheHit,      "mem.shadercache.hit",       "count", Mem)
TLM_COUNTER(MemShaderCacheHitAux,   "mem.shadercache.hit_aux",   "count", Mem)
TLM_COUNTER(MemShaderCacheMiss,     "mem.shadercache.miss",      "count", Mem)
TLM_COUNTER(MemTexCacheChecks,      "mem.texcache.checks",       "count", Mem)
TLM_COUNTER(MemTexCacheReloads,     "mem.texcache.reloads",      "count", Mem)
TLM_COUNTER(MemTexCacheReloadBytes, "mem.texcache.reload_bytes", "bytes", Mem)
TLM_COUNTER(MemIndexUploadBytes,    "mem.index.upload_bytes",    "bytes", Mem)

// ------------------------------------------------------------------- Accuracy signals
// "We knowingly did the wrong thing, and a title just hit it." Each of these maps to a
// row in docs/hardware/09-accuracy-gap-register.md.
TLM_COUNTER(AccUnsupportedHleCalls, "acc.unsupported_hle_calls", "count", Accuracy)
TLM_COUNTER(AccDepth24Stencil8Use,  "acc.d24_s8_use",            "count", Accuracy)
TLM_COUNTER(AccSelfDependency,      "acc.render_self_dependency","count", Accuracy)
TLM_COUNTER(AccDcStoreRangeMissed,  "acc.dcstorerange_no_notify","count", Accuracy)
TLM_COUNTER(AccGeometryDrawDropped, "acc.geometry_draw_dropped", "count", Accuracy)
TLM_COUNTER(AccUnsupportedTexFormat,"acc.unsupported_tex_format","count", Accuracy)
TLM_COUNTER(AccUnsupportedPrimitive,"acc.unsupported_primitive", "count", Accuracy)
TLM_COUNTER(AccDrawSkippedNoTarget, "acc.draw_skipped_no_target","count", Accuracy)
TLM_COUNTER(AccDrawSkippedShaderErr,"acc.draw_skipped_shader_err","count",Accuracy)
TLM_COUNTER(AccAudioFrameServiced,  "acc.audio_frames_serviced", "count", Accuracy)
TLM_COUNTER(AccAudioUpdatePolls,    "acc.audio_update_polls",    "count", Accuracy)
// Draws issued with DB_ALPHA_TO_MASK.ALPHA_TO_MASK_ENABLE set. GX2SetAlphaToMaskReg was
// 92% of BotW's unresolved-import volume, but that only says the setter is hot -- this
// says whether the state it sets is ever actually on, which is what decides whether the
// MSL emitter needs an ordered-dither path.
TLM_COUNTER(AccAlphaToMaskDraws,    "acc.alpha_to_mask_draws",   "count", Accuracy)
